<Window x:Class="DLSSUpdater.Views.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
        <StackPanel Margin="24,22,24,20">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Mark" Width="3" Height="16" Background="{StaticResource Accent}" Margin="0,0,10,0" />
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,14,0,22" LineHeight="19" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource BtnPrimary}" IsDefault="True" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
