<Application x:Class="DLSSUpdater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:DLSSUpdater.Views"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Nvidia.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <v:NullToVisibility x:Key="NullToVis" />
            <v:InverseBoolToVisibility x:Key="InvBoolToVis" />
            <v:StateToBrush x:Key="StateToBrush" />
            <v:EqualsToBool x:Key="EqualsToBool" />
            <v:EqualsToVisibility x:Key="EqualsToVis" />
            <v:HelpTip x:Key="HelpTip" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
